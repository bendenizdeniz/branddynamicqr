generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  BRAND
  SUBVENDOR
}

model Identity {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  role          Role      @default(SUBVENDOR)

  ownerId       Int?
  owner         Owner?    @relation(fields: [ownerId], references: [id])
  
  brandId       Int?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  
  subvendorId   Int?
  subvendor     Subvendor? @relation(fields: [subvendorId], references: [id])

  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  last_login    DateTime?
}

model Owner {
  id            Int        @id @default(autoincrement())
  ext_id        String     @unique
  name          String
  official_name String?
  vkn           String     @unique
  address       String?
  
  brands        Brand[]
  identities    Identity[]

  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  is_deleted    Boolean    @default(false)
}

model Brand {
  id                Int               @id @default(autoincrement())
  ext_id            String            @unique
  name              String
  official_name     String?
  vkn               String            @unique
  address           String?
  icon              String?
  coordX            String?
  coordY            String?
  thumbnail         String?
  phone             String?
  
  ownerId           Int
  owner             Owner             @relation(fields: [ownerId], references: [id])
  
  subvendors        Subvendor[]
  category_products CategoryProduct[]
  identities        Identity[]

  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  is_deleted        Boolean           @default(false)
}

model Subvendor {
  id              Int      @id @default(autoincrement())
  ext_id          String   @unique
  name            String
  phone           String?
  is_franchise    Boolean  @default(false)
  
  country         String?  @default("Türkiye")
  city            String?  
  district        String?  
  address_detail  String?  @db.Text
  
  latitude        Float?   
  longitude       Float?   

  payment_methods Json?    

  is_active       Boolean  @default(true)

  languageId      Int      
  defaultLanguage Language @relation(fields: [languageId], references: [id])
  brandId         Int
  brand           Brand    @relation(fields: [brandId], references: [id])
  
  official_name   String?
  vkn             String?
  employee_volume Int?     @default(0)
  identities      Identity[]
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  is_deleted      Boolean  @default(false)
}

model Product {
  id              Int               @id @default(autoincrement())
  ext_id          String            @unique
  category_links  CategoryProduct[]

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  is_deleted      Boolean           @default(false)
}

model Category {
  id              Int               @id @default(autoincrement())
  ext_id          String            @unique
  type            String?
  product_links   CategoryProduct[]

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  is_deleted      Boolean           @default(false)
}

model CategoryProduct {
  id              Int       @id @default(autoincrement())
  ext_id          String    @unique @default(uuid())
  
  brandId         Int
  categoryId      Int
  productId       Int
  price           Float

  brand           Brand     @relation(fields: [brandId], references: [id])
  category        Category  @relation(fields: [categoryId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  is_deleted      Boolean   @default(false)

  @@unique([brandId, categoryId, productId])
}

model Language {
  id              Int           @id @default(autoincrement())
  code            String        @unique
  name            String
  values          StringValue[]
  subvendors      Subvendor[]

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  is_deleted      Boolean       @default(false)
}

model StringValue {
  id              Int       @id @default(autoincrement())
  entity_id       Int
  value           String
  type            String
  
  languageId      Int
  language        Language  @relation(fields: [languageId], references: [id])

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  is_deleted      Boolean   @default(false)

  @@unique([entity_id, languageId, type])
}